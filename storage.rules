rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /videos/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.size < 700 * 1024 * 1024;
    }
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
